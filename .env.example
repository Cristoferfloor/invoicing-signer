# Puerto expuesto en el host
SIGNER_PORT=3001

# Donde estan los certificados:
#   postgres  cifrados en la base del firmador (flujo normal)
#   archivos  .p12 en ./certificados y claves en variables (solo desarrollo)
SIGNER_STORE=postgres

# Cuanto tiempo se cachea un certificado ya abierto (ms)
SIGNER_CERT_CACHE_TTL_MS=3600000

# --- Almacen postgres ---
SIGNER_PG_URL=postgres://signer:CLAVE@postgres:5432/signer
# Llave maestra de cifrado, 32 bytes en base64: openssl rand -base64 32
# Si se pierde, los certificados guardados no se pueden descifrar.
SIGNER_MASTER_KEY=
# Token para cargar y consultar certificados (header X-Token-Admin)
SIGNER_ADMIN_TOKEN=

# --- Almacen archivos (desarrollo) ---
# Usuario con el que corre el contenedor: debe poder leer los .p12 de
# ./certificados. Obtener con: id -u && id -g
SIGNER_UID=1000
SIGNER_GID=1000
# Clave por defecto de los .p12 en ./certificados
SIGNER_CERT_PASSWORD_DEFAULT=
# Clave por certificado. El nombre se arma con el ref en mayusculas:
# certificado "demo" -> CERT_PASSWORD_DEMO
# CERT_PASSWORD_DEMO=

